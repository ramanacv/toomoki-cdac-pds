VITE_DATA_SOURCE=api
VITE_API_BASE_URL=/api
VITE_OIDC_AUTHORITY=http://localhost:8080/realms/viksitpds
VITE_OIDC_CLIENT_ID=pds-web
# Vite dev/preview proxy target (Docker Compose sets http://api:3000 on the web service)
# VITE_API_PROXY_TARGET=http://localhost:3000
PORT=3000
# Ledger mode: demo (default, in-process chaincode) or fabric (Hyperledger gateway)
# PDS_LEDGER_MODE=demo
PDS_AUTH_MODE=oidc
PDS_AUTHORIZATION_MODE=database
PDS_OIDC_ISSUER=http://localhost:8080/realms/viksitpds
PDS_OIDC_AUDIENCE=pds-api
PDS_OIDC_JWKS_URI=http://localhost:8080/realms/viksitpds/protocol/openid-connect/certs
PDS_OIDC_CLOCK_SKEW_SECONDS=30
PDS_CORS_ORIGINS=http://localhost:4173
PDS_ALLOW_RESET=false
# Compose demo defaults (API code defaults remain 120/30 when unset):
# PDS_RATE_LIMIT_READ_PER_MINUTE=600
# PDS_RATE_LIMIT_MUTATION_PER_MINUTE=120

# Public HTTPS demo edge (docker compose --profile edge). Prefer generating these with:
#   scripts/edge/configure-https-demo-env.sh --ip <elastic-ip> --email you@example.com --write-env
# PDS_WEB_HOST=151.185.43.18.sslip.io
# PDS_AUTH_HOST=auth.151.185.43.18.sslip.io
# PDS_ACME_EMAIL=you@example.com
# PDS_PUBLIC_WEB_ORIGIN=https://151.185.43.18.sslip.io
# VITE_OIDC_AUTHORITY=https://auth.151.185.43.18.sslip.io/realms/viksitpds
# PDS_OIDC_ISSUER=https://auth.151.185.43.18.sslip.io/realms/viksitpds
# PDS_OIDC_JWKS_URI=http://keycloak:8080/realms/viksitpds/protocol/openid-connect/certs
# PDS_CORS_ORIGINS=https://151.185.43.18.sslip.io
# KC_HOSTNAME=auth.151.185.43.18.sslip.io
# KC_HOSTNAME_URL=https://auth.151.185.43.18.sslip.io
# KC_HOSTNAME_ADMIN_URL=https://auth.151.185.43.18.sslip.io
# KC_PROXY_HEADERS=xforwarded
# KC_HTTP_ENABLED=true

PDS_PERSISTENCE_BACKEND=file
PDS_POSTGRES_DSN=postgresql://pds:pds@localhost:5432/pds_chain
PDS_LEDGER_BACKEND=chaincode-runtime
PDS_FABRIC_CLIENT_ORG=FoodAndCivilSupplies
PDS_STATE_PATH=./tmp/pds-state.json
PDS_LEDGER_JOURNAL_PATH=./tmp/pds-ledger.ndjson
PDS_CHAINCODE_STATE_PATH=./tmp/chaincode-world-state.json
PDS_FABRIC_ENVELOPE_PATH=./tmp/pds-fabric-envelope.ndjson
PDS_ELIGIBILITY_SERVICE_URL=http://localhost:3010
PDS_ELIGIBILITY_SERVICE_TIMEOUT_MS=3000
# Required for API-to-eligibility-mock authentication. Supply locally; never commit a real token.
PDS_ELIGIBILITY_SERVICE_TOKEN=
