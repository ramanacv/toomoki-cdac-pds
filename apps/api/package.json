{
  "name": "@pds/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/src/main.js",
  "types": "./src/main.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "eslint src --ext .ts",
    "test": "vitest run --exclude 'test/e2e/**'",
    "test:http": "vitest run test/e2e/demo-api.e2e.spec.ts test/e2e/eligibility-api.e2e.spec.ts",
    "test:fabric": "vitest run test/e2e/fabric-api.e2e.spec.ts",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/src/main.js"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.13.4",
    "@hyperledger/fabric-gateway": "^1.7.1",
    "@nestjs/common": "^11.1.3",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.3",
    "@nestjs/platform-express": "^11.1.3",
    "@pds/pds-chaincode": "*",
    "@pds/fixtures": "*",
    "@pds/shared-types": "*",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "helmet": "^8.3.0",
    "pg": "^8.16.0",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.1.3",
    "@types/node": "^22.15.29",
    "@types/pg": "^8.15.2",
    "@types/supertest": "^6.0.3",
    "@vitest/coverage-v8": "^3.2.6",
    "supertest": "^7.2.2"
  }
}
