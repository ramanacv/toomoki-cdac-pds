{
  "name": "pds-chain",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*",
    "blockchain/chaincode/*"
  ],
  "scripts": {
    "build": "npm run build --workspace=@pds/shared-types && npm run build --workspace=@pds/fixtures && npm run build --workspaces --if-present",
    "lint": "eslint apps packages blockchain/chaincode --ext .ts,.tsx --max-warnings 0",
    "fixtures:sql": "node scripts/generate-postgres-seed.mjs",
    "fixtures:integrations": "node scripts/seed-integration-fixtures.mjs",
    "pretest": "npm run build --workspace=@pds/shared-types && npm run build --workspace=@pds/fixtures && npm run build --workspace=@pds/pds-chaincode",
    "demo:happy": "node scripts/demo/happy-path.mjs",
    "demo:exception": "node scripts/demo/exception-path.mjs",
    "smoke": "npm run build && node scripts/smoke.mjs",
    "smoke:fabric": "node scripts/smoke-fabric-gateway.mjs",
    "regression": "node scripts/regression.mjs",
    "regression:fabric": "PDS_E2E_FABRIC=true node scripts/regression.mjs --fabric",
    "fabric:bootstrap": "node scripts/fabric/bootstrap-chaincode-runtime.mjs",
    "seed": "node scripts/seed.mjs",
    "reset": "node scripts/reset.mjs",
    "test": "npm run test --workspaces --if-present",
    "test:demo-http": "npm run test:http --workspace=@pds/api",
    "test:iam": "bash -n scripts/iam/bootstrap-keycloak.sh && npx vitest run apps/api/test/iam-config.spec.ts apps/api/test/durable-authorization.spec.ts",
    "test:lifecycle": "node --check scripts/live-lifecycle.mjs && node --check scripts/seed-integration-fixtures.mjs && npx vitest run apps/api/test/lifecycle-script.spec.ts apps/api/test/integration-postgres-atomicity.spec.ts",
    "iam:bootstrap": "scripts/iam/bootstrap-keycloak.sh",
    "iam:configure-public-web": "scripts/iam/configure-public-web-client.sh",
    "edge:https-env": "scripts/edge/configure-https-demo-env.sh",
    "benchmark:competition": "node scripts/benchmark-competition.mjs",
    "security:evidence": "scripts/generate-security-evidence.sh",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "@eslint/js": "^9.29.0",
    "@types/node": "^22.15.29",
    "eslint": "^9.29.0",
    "prettier": "^3.5.3",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.36.0",
    "vitest": "^3.2.4"
  },
  "overrides": {
    "esbuild": "0.28.1"
  }
}
